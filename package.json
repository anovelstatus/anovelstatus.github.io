{
	"name": "a-novel-status",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "eslint",
		"lint-fix": "eslint --fix",
		"fmt": "oxfmt . --check",
		"fmt-fix": "oxfmt . --write",
		"website": "cd website && vite",
		"build-website": "cd website && tsc -b && vite build",
		"build-api": "cd api && tsc && node build.ts",
		"config-api": "node config-clasp.ts api",
		"deploy-api": "cd api/dist/ && clasp push -f && clasp update-deployment $DEPLOYMENT_ID",
		"build-spreadsheet": "cd spreadsheet && tsc && node build.ts",
		"config-spreadsheet": "node config-clasp.ts spreadsheet",
		"deploy-spreadsheet": "cd spreadsheet/dist/ && clasp push",
		"test-spreadsheet": "cd spreadsheet && vitest",
		"build-all": "npm run build-api && npm run build-spreadsheet && npm run build-website"
	},
	"devDependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@eslint/js": "^9.39.5",
		"@google/clasp": "^3.4.1",
		"@mui/icons-material": "^9.4.0",
		"@mui/material": "^9.4.0",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/react-table": "^9.2.4",
		"@tanstack/router-plugin": "^1.168.35",
		"@types/google-apps-script": "2.0.12",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"dotenv": "^17.4.2",
		"es-toolkit": "^1.52.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"material-ui-popup-state": "^5.3.7",
		"oxfmt": "^0.65.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"rolldown": "^1.2.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
