{
	"name": "a-novel-status",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "eslint",
		"lint-fix": "eslint --fix",
		"fmt": "oxfmt . --check",
		"fmt-fix": "oxfmt . --write",
		"website": "cd website && vite",
		"build-website": "cd website && tsc -b && vite build",
		"build-api": "cd api && tsc && node build.ts",
		"config-api": "node config-clasp.ts api",
		"deploy-api": "cd api/dist/ && clasp push -f && clasp update-deployment $DEPLOYMENT_ID",
		"build-spreadsheet": "cd spreadsheet && tsc && node build.ts",
		"config-spreadsheet": "node config-clasp.ts spreadsheet",
		"deploy-spreadsheet": "cd spreadsheet/dist/ && clasp push",
		"test-spreadsheet": "cd spreadsheet && vitest",
		"build-all": "npm run build-api && npm run build-spreadsheet && npm run build-website"
	},
	"devDependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@eslint/js": "^9.39.5",
		"@google/clasp": "^3.4.1",
		"@mui/icons-material": "^9.5.0",
		"@mui/material": "^9.5.0",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@tanstack/react-devtools": "^0.10.14",
		"@tanstack/react-query": "^5.105.0",
		"@tanstack/react-query-devtools": "^5.105.0",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-table": "^9.3.1",
		"@tanstack/react-table-devtools": "^9.3.1",
		"@tanstack/router-plugin": "^1.168.48",
		"@types/google-apps-script": "2.0.14",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"dotenv": "^18.0.9",
		"es-toolkit": "^1.53.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"material-ui-popup-state": "^5.3.7",
		"oxfmt": "^0.75.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rolldown": "^1.2.16",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
